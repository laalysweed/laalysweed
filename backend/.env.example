# FULL reference of every backend option. Copy only the ones you need into .env; the rest have defaults.
# ---------- Core ----------
NODE_ENV=development
PORT=4000
# Public URL of the Angular app (used in e-mails and CORS)
APP_URL=http://localhost:4200
# Public URL of this API (used for M-Pesa callbacks). Must be HTTPS and reachable from the internet for real Daraja callbacks.
API_PUBLIC_URL=http://localhost:4000
# Optional: defaults to APP_URL (and its www / non-www twin)
# CORS_ORIGINS=

# ---------- Database ----------
# Leave empty in development to use an embedded MongoDB replica set stored in ./.data/mongo
# With Docker:  MONGO_URI=mongodb://localhost:27017/y2markets?replicaSet=rs0&directConnection=true
MONGO_URI=

# ---------- Auth ----------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Optional: defaults to true when APP_URL starts with https://
# COOKIE_SECURE=

# ---------- Market engine ----------
# Secret seed for the OTC price generator. Keep it private in production.
OTC_SEED=change-me-otc-seed
BINANCE_ENABLED=true
BINANCE_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_REST_URL=https://api.binance.com
# 0 = keep ticks forever (full audit trail)
TICK_RETENTION_DAYS=0

# ---------- E-mail (leave SMTP_HOST empty to print e-mails to the console) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Y2 Markets <no-reply@y2markets.site>

# ---------- M-Pesa STK push via PayHero (default provider) ----------
# payhero = send STK pushes through PayHero; daraja = call Safaricom Daraja directly (settings below)
MPESA_PROVIDER=payhero
PAYHERO_BASE_URL=https://backend.payhero.co.ke
# PayHero dashboard → API Keys: the "Basic auth token" (with or without the "Basic " prefix)
PAYHERO_AUTH_TOKEN=
# PayHero dashboard → Payment Channels → My Payment Channels
PAYHERO_CHANNEL_ID=
# Optional: your own Daraja credentials registered on PayHero
PAYHERO_CREDENTIAL_ID=
# Callbacks go to {API_PUBLIC_URL}/api/payments/payhero/{MPESA_CALLBACK_SECRET}/callback (must be public HTTPS)

# ---------- M-Pesa Daraja (used when MPESA_PROVIDER=daraja, and for B2C withdrawals) ----------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_B2C_SHORTCODE=600000
MPESA_B2C_INITIATOR=testapi
MPESA_B2C_SECURITY_CREDENTIAL=
# Random string embedded in callback URLs so only Safaricom (who knows the URL) can call them
MPESA_CALLBACK_SECRET=change-me-callback-secret
# true = FAKE payments for local demos only: STK pushes / B2C payouts auto-complete without real money
MPESA_SIMULATE=false
KES_PER_USD=129

# ---------- Other payments ----------
# Enables the simulated card processor (development / demo only)
SANDBOX_PAYMENTS=false
# Deposit methods customers can use; all others are shown locked (e.g. mpesa,usdt_trc20,usdt_bep20)
DEPOSIT_METHODS=mpesa,crypto
# Crypto deposit wallet addresses are managed in Admin → Crypto wallets (not here).

# ---------- Admin bootstrap (created on first start if missing) ----------
ADMIN_EMAIL=admin@y2markets.site
ADMIN_PASSWORD=Admin@12345

UPLOAD_DIR=uploads
REQUIRE_KYC_FOR_WITHDRAWAL=false
